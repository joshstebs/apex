# ApexVoice AI - Vercel & SignalWire Environment Variables
# Copy or link these in Vercel Project Settings -> Environment Variables

# 1. SignalWire Carrier & Webhook Security (Harbour and Main)
SIGNALWIRE_SPACE_URL=harbour-and-main.signalwire.com
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_SIGNING_KEY=
SIGNALWIRE_PHONE_NUMBER=+12267732234
SIGNALWIRE_PHONE_NUMBER_ID=8f935d8b-bd61-457b-b421-edddfef247ea
# Stable hostname used inside cXML action and TTS URLs. Never use an SSO-protected preview.
PUBLIC_URL=https://apex.harbourandmain.com
ENFORCE_WEBHOOK_SIGNATURE=true

# Inbound Harbour & Main receptionist: activate only after test DID and credentials are verified.
RECEPTIONIST_ENABLED=false
INBOUND_ASSISTANT_ID=tpl_hm_receptionist
RECEPTIONIST_BUSINESS_NAME=Harbour & Main
REQUIRE_MATCHING_INBOUND_NUMBER=true
ALLOW_INBOUND_ASSISTANT_OVERRIDE=false
# Configure an external once-per-minute scheduler to POST to
# /api/maintenance/enforce-call-duration with Authorization: Bearer <CRON_SECRET>
# Neither Vercel Hobby nor ordinary webhooks provide an exact 20-minute cutoff.
CRON_SECRET=

# 2. Voice & Language AI
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

HUGGINGFACE_API_KEY=
HUGGINGFACE_ROUTER_URL=https://router.huggingface.co/v1/chat/completions
HUGGINGFACE_LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# 3. Durable Serverless State (Link Existing Vercel Marketplace KV / Upstash or Turso Cloud)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Or Vercel KV aliases (auto-detected if linked from Vercel Storage tab):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Or Turso Cloud HTTP SQLite:
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# 4. Safety & Budget Limits (Outbound is hard-disabled in code)
MAX_CONCURRENT_CALLS=1
MONTHLY_BUDGET_LIMIT_USD=5.00
TTS_CLIP_TTL_SECONDS=120

# Webhook-level duration guard only. NOT a carrier-enforced hard limit.
MAX_CALL_DURATION_SECONDS=1200
# Set to a conservative full-call cost estimate before production
APEX_MAX_CALL_RESERVE_USD=3.00

# Required to access protected administrative endpoints
APEX_ADMIN_TOKEN=
